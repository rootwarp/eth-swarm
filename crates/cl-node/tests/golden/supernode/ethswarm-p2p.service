# Generated by `cl-node units`. Do not edit: regenerate it (crates/cl-node/README.md).
[Unit]
Description=ETH Swarm (mainnet): cl-p2p
After=ethswarm-chain.service
PartOf=ethswarm.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=90s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
ExecStart=/usr/local/bin/cl-p2p
User=ethswarm-p2p
Group=ethswarm-p2p
# The groups of the sockets it calls (ARCH V-9).
SupplementaryGroups=ethswarm-chain ethswarm-discv5 ethswarm-store
RuntimeDirectory=ethswarm/cl-p2p
RuntimeDirectoryMode=0750
StateDirectory=ethswarm-p2p
StateDirectoryMode=0700
LoadCredential=nodekey:/etc/ethswarm/credentials/nodekey
MemoryHigh=1G
MemoryMax=1536M
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=ethswarm.target

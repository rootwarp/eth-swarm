# Generated by `cl-node units`. Do not edit: regenerate it (crates/cl-node/README.md).
[Unit]
Description=ETH Swarm (mainnet): cl-api
After=ethswarm-chain.service
PartOf=ethswarm.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=90s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
ExecStart=/usr/local/bin/cl-api
User=ethswarm-api
Group=ethswarm-api
# The groups of the sockets it calls (ARCH V-9).
SupplementaryGroups=ethswarm-chain ethswarm-discv5 ethswarm-p2p ethswarm-store ethswarm-sync
RuntimeDirectory=ethswarm/cl-api
RuntimeDirectoryMode=0750
MemoryMax=1G
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=ethswarm.target

# Generated by `cl-node units`. Do not edit: regenerate it (crates/cl-node/README.md).
[Unit]
Description=ETH Swarm (mainnet): cl-discv5
After=ethswarm-chain.service
PartOf=ethswarm.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=90s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
ExecStart=/usr/local/bin/cl-discv5
User=ethswarm-discv5
Group=ethswarm-discv5
RuntimeDirectory=ethswarm/cl-discv5
RuntimeDirectoryMode=0750
StateDirectory=ethswarm-discv5
StateDirectoryMode=0700
LoadCredential=nodekey:/etc/ethswarm/credentials/nodekey
MemoryMax=128M
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=ethswarm.target

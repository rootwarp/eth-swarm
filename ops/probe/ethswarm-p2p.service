# ETH Swarm probe: cl-p2p (libp2p req/resp; gossip IGNORE-all). See ops/probe/README.md.
# Linted by ops/probe/tests/probe-units.test.sh: its own User=, the node key only as the
# systemd credential "nodekey" (cl-chain gets none), the two-provider anchor check before start,
# and the hardening below. Do not weaken a line without changing the lint and saying why.
[Unit]
Description=ETH Swarm probe: cl-p2p (libp2p req/resp; gossip IGNORE-all)
Wants=network-online.target
After=network-online.target
# A start that keeps failing (a provider mismatch fails ExecStartPre, which
# RestartPreventExitStatus= does not cover) stops after 3 tries in 6 h.
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
User=ethswarm-p2p
Group=ethswarm-p2p
UMask=0077
# ANCHOR_PROVIDERS=https://<provider A>,https://<provider B>: two independent beacon API
# providers (root 0600; a URL path may hold a key, and anchor-fetch never prints one).
EnvironmentFile=/etc/ethswarm/anchor-check.env
# Start only if both providers agree on the finalized block root, its header state_root and
# the state root (anchor-fetch exits non-zero otherwise, and writes nothing). No "-" prefix:
# a failed check must fail the start.
ExecStartPre=/usr/local/bin/anchor-fetch --providers ${ANCHOR_PROVIDERS} --check
# The check's own worst case: 4 JSON requests at 30 s and two bodies at 30 s + 1800 s each
# (anchor-fetch's defaults), 3780 s, plus margin.
TimeoutStartSec=70min
ExecStart=/usr/local/bin/cl-p2p
# The node key, only as a credential: the binary reads $CREDENTIALS_DIRECTORY/nodekey (owner
# only, refused otherwise); no config file or argument names the key.
LoadCredential=nodekey:/etc/ethswarm/credentials/nodekey
StateDirectory=ethswarm-p2p
StateDirectoryMode=0700
RuntimeDirectory=ethswarm/cl-p2p
RuntimeDirectoryMode=0750
ReadWritePaths=/var/lib/ethswarm-p2p
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Memory ceiling (README "Resource limits"), for every process of the unit, the check
# included: at MemoryMax= the kernel OOM-kills. No MemoryHigh=: without swap, past it the
# kernel only throttles, and a throttled probe stalls instead of being killed.
# 7G: every connection's 32 MiB mplex budget full at once (160 x 32 MiB = 5 GiB), the
# req/resp responses (2 x 256 MiB), gossip caches (256 MiB) and the baseline (about
# 0.3 GiB) come to about 6.05 GiB, so the transport's own budgets act before the ceiling.
MemoryMax=7G
# No swap, so the ceiling cannot be dodged by swapping out.
MemorySwapMax=0
# An OOM kill (SIGKILL, a signal, not an exit code) stops the unit with result oom-kill,
# a failure: Restart=on-failure restarts it, within the start limit. Set here, not left to
# the host's DefaultOOMPolicy=.
OOMPolicy=stop
Restart=on-failure
RestartSec=5min
# No restart on a refusal that a restart cannot fix: 1 a refused credential, 2 the stub
# (or a refused config), 64 a usage error. Exit codes of the main process only.
# Not listed, so restarted: 71 EXIT_NO_LOG_WRITER (EX_OSERR), cl-p2p could not start its
# log-writer thread and exited at once, leaving stderr empty on purpose (no journal line).
# A thread limit can lift; check the unit's thread/process limits (TasksMax=, ulimit -u)
# and free memory (README "Anchor check").
RestartPreventExitStatus=1 2 64

[Install]
WantedBy=multi-user.target

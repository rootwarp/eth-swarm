# Reference node (compose.yaml) on Sepolia. Copy to .env, fill CHECKPOINT_SYNC_URL, then run
# setup.sh as root: it writes DATA_ROOT and the four id lines below and makes .env mode 0600.
# Hoodi: start from .env.hoodi.example instead (other ports, DATA_ROOT and users, so both run
# on one host). docker compose reads this file as data; preflight.sh, setup.sh and
# collect-run-log.sh read it without sourcing it.

# The network: sepolia or hoodi. It picks the clients' chain, the pinned config
# (crates/network-config/networks/<network>/config.yaml), the README.md release-note table, the
# service users (reth and lighthouse on Sepolia, reth-<network> and lighthouse-<network>
# elsewhere) and the compose project (<network>-ref).
NETWORK=sepolia

# Images, pinned by tag and index digest (preflight.sh refuses anything else). README.md lists
# the release-note lines that show each supports the network's Gloas / Amsterdam fork.
RETH_IMAGE=ghcr.io/paradigmxyz/reth:v2.7.0@sha256:a7f059d470878a5a59f3c575f3fc81b536d0d2d56d7a1cbed73e717a4f766336
LIGHTHOUSE_IMAGE=sigp/lighthouse:v8.3.0-rc.0@sha256:3e5f0609c74b824d3cb1049920169114d99fd7bc9082b996b3adae3d4e9ef8dc

# Lighthouse checkpoint sync (provider 1). Required; preflight.sh checks its
# /eth/v1/config/spec against the pinned config. https://, or http:// to a loopback host.
CHECKPOINT_SYNC_URL=
# A second checkpoint provider, run by another operator: optional on Sepolia, required on
# Hoodi. preflight.sh checks its spec too and that both agree on provider 1's finalized block.
CHECKPOINT_SYNC_URL_2=

# Comma-separated peer IDs Lighthouse trusts (--trusted-peers): the m2a-session
# `--print-peer-id` output. Empty: no trusted peers.
TRUSTED_PEERS=

# Ports. The Engine API and the Beacon API listen on 127.0.0.1 only; the p2p ports are the
# only ones the firewall opens (RETH_P2P_PORT tcp/udp, LIGHTHOUSE_P2P_PORT tcp/udp,
# LIGHTHOUSE_QUIC_PORT udp). A second network on the same host takes other ones.
ENGINE_PORT=8551
BEACON_API_PORT=5052
RETH_P2P_PORT=30303
LIGHTHOUSE_P2P_PORT=9000
LIGHTHOUSE_QUIC_PORT=9001

# Where the data directories and JWT copies live (setup.sh --root overrides it).
DATA_ROOT=/srv/ethswarm-ref

# Written by setup.sh: the service users' ids.
RETH_UID=
RETH_GID=
LIGHTHOUSE_UID=
LIGHTHOUSE_GID=

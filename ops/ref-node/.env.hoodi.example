# Reference node (compose.yaml) on Hoodi, next to a Sepolia one on the same host. Copy to
# .env.hoodi, fill both checkpoint providers, then run every script and compose with
# `--env-file .env.hoodi` (setup.sh as root writes DATA_ROOT and the ids, mode 0600). The keys
# are those of .env.example, which explains each; only the values differ: its own ports,
# DATA_ROOT and (from NETWORK) users reth-hoodi and lighthouse-hoodi, compose project hoodi-ref.
NETWORK=hoodi

# No release schedules Hoodi's Gloas / Amsterdam fork (epoch 132352, 2026-10-26 17:42:48 UTC)
# yet, so Hoodi runs two dev builds, pinned by digest; README.md records the source commit and
# fork-schedule check of each, and preflight.sh accepts no other Hoodi image. These digests stay
# pullable only while the registries keep them: pull both onto the host now and keep them
# (README.md, Hoodi), and move to releases by its "Repin to releases" checklist.
RETH_IMAGE=ghcr.io/paradigmxyz/reth:nightly@sha256:8765a1d57878bebd40362d71bbfc0834d231847952402f9a10848c14476b90d2
LIGHTHOUSE_IMAGE=sigp/lighthouse:latest-unstable@sha256:be7fdbcd4a321647f0300ae8dc3a9542bf391129ecaf521892f0b27dfe2e9658

# Two checkpoint providers run by different operators (both required on Hoodi): Lighthouse
# syncs from the first; preflight.sh checks both specs and that both hold the first one's
# finalized block with the same block and state root.
CHECKPOINT_SYNC_URL=
CHECKPOINT_SYNC_URL_2=

TRUSTED_PEERS=

# Not the Sepolia node's ports (8551, 5052, 30303, 9000, 9001).
ENGINE_PORT=8552
BEACON_API_PORT=5053
RETH_P2P_PORT=30304
LIGHTHOUSE_P2P_PORT=9002
LIGHTHOUSE_QUIC_PORT=9003

DATA_ROOT=/srv/ethswarm-ref-hoodi

# Written by setup.sh.
RETH_UID=
RETH_GID=
LIGHTHOUSE_UID=
LIGHTHOUSE_GID=

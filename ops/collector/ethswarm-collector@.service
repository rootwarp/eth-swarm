# ETH Swarm arrival collector, one instance per network: ethswarm-collector@hoodi.service and
# ethswarm-collector@sepolia.service, each reading its reference node's /eth/v1/events and
# stamping every event on arrival. See ops/collector/README.md.
#
# Each instance runs as its own system user, ethswarm-collector-<network>: with one shared user
# either instance could read and write the other's state directory (through /proc/<pid>/root
# too, since ProtectProc=invisible hides only other users' processes).
#
# Each instance takes its settings from /etc/ethswarm/collector-<network>.env (examples:
# ops/collector/collector-<network>.env.example): COLLECTOR_NETWORK, COLLECTOR_OUT and
# COLLECTOR_NTP, nothing else. Its topic set (the SSE events and the sampled attestation
# subnets) is in /etc/ethswarm/collector-<network>.topics.toml (root, 0644), passed by
# --topics-file and read by the binary as data, never through the environment. The reference
# node's URL is in /etc/ethswarm/collector-<network>.url (mode 0600, the instance user's), read
# by --url-file, so a key in it never reaches argv (/proc/<pid>/cmdline is world-readable).
# Nothing here names a node: on a host that runs both reference nodes, Sepolia's beacon API is
# 127.0.0.1:5052 and Hoodi's 127.0.0.1:5053, and a hardcoded URL would let a Hoodi collector
# record Sepolia. The binary also refuses a node whose CONFIG_NAME (or, for Sepolia, genesis) is
# not its network's.
#
# Same hardening as the probe units, plus loopback-only IP: the collector talks to the node's
# beacon API on 127.0.0.1 and to chronyd on 127.0.0.1:323, and to nothing else. Do not weaken a
# line without saying why.
[Unit]
Description=ETH Swarm arrival collector (%i reference node SSE)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ethswarm-collector-%i
Group=ethswarm-collector-%i
UMask=0027
# Required: an instance without its env file does not start.
EnvironmentFile=/etc/ethswarm/collector-%i.env
# The env file must stay inside a grammar small enough that the guard and systemd read it the
# same way, and the guard refuses the whole file otherwise; it never tries to parse what
# systemd's parser would make of anything else:
#   - bytes: LF and printable ASCII only, and no quote (" ') or backslash. systemd also ends a
#     line at CR, and unquotes, unescapes and joins continued lines; grep does none of that, so
#     any of those bytes could hide a key (STATE_DIRECTORY, LD_PRELOAD) from a line check;
#   - lines: empty, a `#` comment, or COLLECTOR_NETWORK, COLLECTOR_OUT or COLLECTOR_NTP `=` a
#     value of [A-Za-z0-9._/-], each key exactly once. No `export`, no spaces, no other key;
#   - values: this instance's network, and its own state directory, so two instances never
#     share or swap a capture directory. The directory is compared with the literal path: an env
#     file value would override the STATE_DIRECTORY systemd sets, so that variable proves
#     nothing (and setting it is refused).
# The guard reads the file, never its environment: it runs under `env -i`, every tool by its
# absolute path, so a PATH= line (refused anyway) could not make it run a planted binary.
# systemd reads EnvironmentFile= itself, before this guard runs and before it checks a byte of
# it, so `env -i` protects only the guard's own shell and the tools it starts, not systemd's
# reading of the file. The guard is no substitute for the file's permissions: the env file and
# /etc/ethswarm must stay root-owned and writable by root only.
# The byte rule deletes every allowed byte and counts what is left: the tr set is LF (systemd
# turns the \n into one) and 0x20-0x7E without 0x22 ("), 0x27 (') and 0x5C (\). An unreadable
# file leaves "unreadable", so the count is never 0 by accident.
ExecStartPre=/usr/bin/env -i /bin/sh -c 'env_file=/etc/ethswarm/collector-%i.env; \
    state=/var/lib/ethswarm-collector/%i; \
    refuse() { echo "$$env_file: $$1" >&2; exit 1; }; \
    { [ -f "$$env_file" ] && [ -r "$$env_file" ]; } || refuse "not a readable file"; \
    bad=$$({ /usr/bin/tr -d "\n !#-&(-[]-~" <"$$env_file" || echo unreadable; } | /usr/bin/wc -c | /usr/bin/tr -d " "); \
    [ "$$bad" = 0 ] || refuse "$${bad:-unreadable} bytes other than LF and printable ASCII, or a quote or backslash"; \
    unknown=$$(/usr/bin/grep -Evc "^(#.*)?$$|^(COLLECTOR_NETWORK|COLLECTOR_OUT|COLLECTOR_NTP)=[A-Za-z0-9._/-]+$$" "$$env_file"); \
    [ "$$unknown" = 0 ] || refuse "$${unknown:-unreadable}: want only comments and COLLECTOR_NETWORK, COLLECTOR_OUT and COLLECTOR_NTP lines"; \
    for key in COLLECTOR_NETWORK COLLECTOR_OUT COLLECTOR_NTP; do \
        [ "$$(/usr/bin/grep -c "^$$key=" "$$env_file")" = 1 ] || refuse "want exactly one $$key line"; \
    done; \
    if [ "$$(/usr/bin/grep -Fxc "COLLECTOR_NETWORK=%i" "$$env_file")" != 1 ] || \
        [ "$$(/usr/bin/grep -Fxc "COLLECTOR_OUT=$$state" "$$env_file")" != 1 ]; then \
        refuse "COLLECTOR_NETWORK must be %i and COLLECTOR_OUT $$state"; \
    fi'
# Plain http:// to loopback only (the binary refuses anything else). Each start writes a new
# capture directory /var/lib/ethswarm-collector/%i/%i-<unix start seconds>/; summary.toml is
# written when the unit stops (SIGTERM).
ExecStart=/usr/local/bin/collector sse --network ${COLLECTOR_NETWORK} \
    --url-file /etc/ethswarm/collector-%i.url --out ${COLLECTOR_OUT} --host %H \
    --topics-file /etc/ethswarm/collector-%i.topics.toml --ntp ${COLLECTOR_NTP}
# systemd creates /var/lib/ethswarm-collector root-owned 0755 and only the instance's own
# directory below it as the instance user's, 0750.
StateDirectory=ethswarm-collector/%i
StateDirectoryMode=0750
ReadWritePaths=/var/lib/ethswarm-collector/%i
TimeoutStopSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target

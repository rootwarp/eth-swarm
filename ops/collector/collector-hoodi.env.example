# Settings of the Hoodi collector instance. Install as /etc/ethswarm/collector-hoodi.env (root,
# 0644: it holds no secret); ethswarm-collector@hoodi.service reads it. Only LF and printable
# ASCII, no quote or backslash anywhere (comments too), and only these three KEY=value lines,
# each once, a value of letters, digits and . _ / - only (no quotes, spaces or export): the unit
# refuses the whole file otherwise (a STATE_DIRECTORY line above all). The URL of the reference
# node is not here but in /etc/ethswarm/collector-hoodi.url (collector-hoodi.url.example), so it
# stays out of argv.

# The network: must be the instance name, and the CONFIG_NAME of the node must be the same, or
# the unit refuses to start.
COLLECTOR_NETWORK=hoodi
# The state directory of this instance, the only path the unit may write: captures go into
# /var/lib/ethswarm-collector/hoodi/hoodi-<unix start seconds>/.
COLLECTOR_OUT=/var/lib/ethswarm-collector/hoodi
# The time daemon of the host: chrony (chronyc tracking), timesyncd or none.
COLLECTOR_NTP=chrony

# The Hoodi collector instance's settings. Install as /etc/ethswarm/collector-hoodi.env (root,
# 0644: it holds no secret); ethswarm-collector@hoodi.service reads it. Plain KEY=value lines,
# no quotes, no spaces around `=`, and only these three keys: the unit refuses any other line
# (STATE_DIRECTORY above all). The reference node's URL is not here but in
# /etc/ethswarm/collector-hoodi.url (collector-hoodi.url.example), so it stays out of argv.

# The network: must be the instance name, and the node's CONFIG_NAME must be the same, or the
# unit refuses to start.
COLLECTOR_NETWORK=hoodi
# This instance's state directory, the only path the unit may write: captures go into
# /var/lib/ethswarm-collector/hoodi/hoodi-<unix start seconds>/.
COLLECTOR_OUT=/var/lib/ethswarm-collector/hoodi
# The host's time daemon: chrony (chronyc tracking), timesyncd or none.
COLLECTOR_NTP=chrony

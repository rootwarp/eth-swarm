# Skip list for the spec-vector runner. The runner FAILS on any handler that is neither
# executed nor matched by an entry here. It also fails on an entry past its expiry date,
# and on an entry that matches no file of the scanned vectors (stale). Staleness is checked only for entries that a
# scanned set could match (its source, presets, forks and runners; see crates/spec-tests/src/
# suite.rs SETS), so mainnet or cryptography-specs entries do not fail a run that did not
# extract those sets, and a run of `general` alone (altair/bls only) checks only bls entries.
#
# Coverage guard: after an unfiltered run, every file under the scanned vector roots must
# have been read by a handler. Files of skipped cases are exempt; any other file needs an
# entry with `file`. Such an entry skips nothing: the case still runs, and only the matching
# files are excused.
#
# Fields (every value except `source` is a glob: `*` matches any run of characters):
#   source    "consensus-specs" | "ssz-specs" | "cryptography-specs" | "bls12-381-tests" |
#             "comptests" (consensus-specs comptests.tar.gz)        (required, literal)
#   fork      e.g. "fulu", "gloas"; "none" for sources without forks (required)
#   preset    "minimal" | "mainnet" | "general" | "none" | "*"      (required)
#             (source "comptests": "minimal" | "core" | "formats" | "generators" | "*")
#   runner    e.g. "operations", "fork_choice", "kzg", "bls", "ssz" (required)
#   handler   e.g. "payload_attestation"; "*" = whole runner        (required)
#   case      glob over case names (`<suite>/<case>` for consensus-specs); omit = all cases
#                                                                   (optional)
#   file      glob over file paths inside the case, e.g. "value.yaml"; makes the entry a
#             coverage excuse instead of a skip                     (optional)
#   reason    why it is skipped                                     (required)
#   owner     team member responsible                               (required)
#   issue     plan item whose work removes the entry, e.g. "1.17", or "none"
#                                                                   (required)
#   expires   YYYY-MM-DD; valid through that day, and from the next day the entry fails CI
#                                                                   (required)
#
# A missing or blank reason, owner, issue or expires fails parsing. The first matching case
# entry gives a case its reason, so put narrow entries before broad ones.

[[skip]]
source  = "consensus-specs"
fork    = "*"
preset  = "*"
runner  = "*"
handler = "*"
case    = "*"
reason  = "EXAMPLE ONLY: pre-Fulu forks are out of scope (DECISIONS 2026-10-15: Fulu and Gloas only). Narrow this to the real fork names."
owner   = "ian"
issue   = "none"
expires = "2026-12-31"

[[skip]]
source  = "consensus-specs"
fork    = "gloas"
preset  = "minimal"
runner  = "fork_choice"
handler = "on_payload_attestation_message"   # real handler at v1.7.0-beta.4 minimal/gloas/fork_choice
case    = "*_ptc_*"
reason  = "EXAMPLE: PTC fork-choice handling not implemented yet"
owner   = "tess"
issue   = "4.7"
expires = "2026-11-15"

[[skip]]
source  = "consensus-specs"
fork    = "*"
preset  = "*"
runner  = "ssz_static"
handler = "*"
file    = "value.yaml"   # the case still runs; only value.yaml is excused from the guard
reason  = "EXAMPLE: value.yaml repeats serialized.ssz_snappy as YAML and is not decoded"
owner   = "ian"
issue   = "none"
expires = "2026-11-30"

[[skip]]
source  = "ssz-specs"
fork    = "*"
preset  = "*"
runner  = "ssz"
handler = "test_progressive_containers"   # real handler: fixtures/ssz/ssz/test_progressive_containers
reason  = "EXAMPLE: progressive containers (EIP-7916/7495) not supported by our SSZ crate yet"
owner   = "ian"
issue   = "none"
expires = "2026-11-30"
